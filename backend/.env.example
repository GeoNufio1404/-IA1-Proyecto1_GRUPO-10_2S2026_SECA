# Copia este archivo como .env para desarrollo local.
# .env esta en .gitignore: nunca subas credenciales al repositorio.

# Puerto local. En Cloud Run lo inyecta la plataforma, no lo definas alli.
PORT=8000

# Base de conocimiento a cargar al arrancar.
PROLOG_KB=prolog/base.pl

# Habilita POST /api/query (objetivos Prolog arbitrarios).
# Solo en local: Prolog puede leer archivos y lanzar procesos del sistema.
ALLOW_RAW_QUERY=false
